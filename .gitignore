# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# Virtual env
.venv/
venv/

# IDE
.vscode/
.idea/

# OS
.DS_Store

# Kratos outputs (important)
data/
*.log

# Self-writing loop: staged tool candidates (Part A output) -- never live,
# never TOOL_REGISTRY-reachable, disposable by design. See
# src/kratos/agent/self_write.py and docs/sprint2_self_writing_loop_design.md.
sandbox_staging/

# Self-writing loop: APPROVED, live tool source + persisted requires_approval
# metadata (Part D output). Runtime-generated per-installation state, not
# source code -- same class as data/, not something to track. See
# src/kratos/agent/self_write_loop.py.
kept_tools/

# Local configs and secrets -- .env.example is the only env-shaped file shipped
.env
.env.*
*.env
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*
id_ecdsa*
known_hosts

# Databases / session stores anywhere (the default lives in data/, but a
# custom --data-dir or a copied snapshot can land elsewhere)
*.db
*.db-*
*.db.*
*.sqlite
*.sqlite3

# Generated sub-agent installers (they embed a live pairing code)
kratos-subagent-install-*.sh
kratos-subagent-upgrade-*.sh

# Captures, logs, screenshots
*.pcap
*.pcapng
logs/
screenshots/
*.png
*.jpg
*.jpeg
*.gif
!docs/images/**

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# LLM model files (large binaries — download separately)
llm/models/
*.gguf

# vulscan NSE script + CVE database (large, periodically-updated data --
# download separately, same class as llm/models/. See
# src/kratos/adapters/vuln_scan.py and vulscan/README.md for the install
# step and directory layout nmap's own script/data resolution requires.)
vulscan/

# Scratch / temp files
Hello!
can
llm/not
llm/notes
llm/work/

# Shell scripts, markdown, and text files -- working notes, not shipped --
# except the published docs listed here. Named explicitly (not a blanket
# !README.md) so a README in a private or generated directory, e.g.
# docs/deprecated/, is never pulled in.
*.sh
*.md
*.txt
!/README.md
!docs/DESIGN.md
!docs/GUIDE.md
!yara_rules/README.md
!scripts/attacks/README.md
!scripts/attacks/wordlists/README.md
# Test fixtures are shipped data, not scratch -- keep them tracked despite the
# blanket *.sh/*.md/*.txt ignores above.
!tests/fixtures/**

# Local data-directory backups (e.g. data.bak.20260705_pretest/) -- not code
data.bak*/

# Repomix output
repomix-output.xml
