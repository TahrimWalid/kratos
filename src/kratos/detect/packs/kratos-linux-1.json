  {
   "attack": [
    "T1098"
   ],
   "author": "Kratos",
   "count": null,
   "date": "2026-10-26",
   "description": "An account was added to a group whose members can become root (sudo, wheel, admin, docker, lxd, libvirt, disk, shadow ...). Attackers do this to keep root access.",
   "falsepositives": [
    "An administrator granting admin rights on purpose"
   ],
   "id": "KRATOS-ACCOUNT-PRIVILEGED-GROUP",
   "level": "high",
   "license": "MIT",
   "logsource": {
    "category": null,
    "product": "linux",
    "service": "auth"
   },
   "match": {
    "args": [
     {
      "cased": true,
      "field": "event.action",
      "op": "eq",
      "value": "account_added_to_group"
     },
     {
      "cased": true,
      "field": "group.name",
      "op": "in",
      "values": [
       "sudo",
       "wheel",
       "admin",
       "root",
       "docker",
       "lxd",
       "incus-admin",
       "libvirt",
       "disk",
       "shadow"
      ]
     }
    ],
    "op": "all_of"
   },
   "modified": "2026-10-26",
   "references": [],
   "samples": {
    "match": [
     {
      "event.action": "account_added_to_group",
      "event.dataset": "kratos.auth",
      "event.id": "kratos-sample-pg-1",
      "group.name": "sudo",
      "user.name": "carol"
     }
    ],
    "no_match": [
     {
      "event.action": "account_added_to_group",
      "event.dataset": "kratos.auth",
      "event.id": "kratos-sample-pg-0",
      "group.name": "audio",
      "user.name": "carol"
     }
    ]
   },
