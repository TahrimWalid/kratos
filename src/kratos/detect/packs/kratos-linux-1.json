  {
   "attack": [
    "T1136.001"
   ],
   "author": "Kratos",
   "count": null,
   "date": "2026-10-26",
   "description": "A new account with a user id of 1000 or more (a person's account, not a system service account) was created.",
   "falsepositives": [
