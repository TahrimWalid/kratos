# Kratos settings
#
# To get started, choose ONE model below and remove the "# " at the start of its
# four lines (LLM_BASE_URL, LLM_API_KEY, LLM_MODEL, KRATOS_LLM_BACKEND). Leave the
# other models commented out. Then save, start `kratos`, and run /doctor: its
# first line says whether the model answered.
#
# Prefer not to edit this file? Start `kratos` and add a model under
# Settings -> Models instead.
#
# This file holds your API key. Only you can read it; never share it or commit it.
# A line starting with "#" is ignored.


# =============================================================================
# 1. YOUR MODEL -- uncomment exactly ONE of these blocks
# =============================================================================

# --- PROFILE: Hosted model (quick start). Any OpenAI-compatible provider.
#     What Kratos reads (log lines, scan results) is sent to that provider, and
#     each investigation costs a little (see /usage). Example: Google Gemini --
#     get a key at https://aistudio.google.com/apikey and paste it below.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=your-real-api-key-here
# LLM_MODEL=gemini-2.5-flash
# KRATOS_LLM_BACKEND=openai_compatible

# --- PROFILE: Local model, fully private (Ollama, vLLM, llama.cpp server).
#     Nothing leaves your hardware and there's no per-use cost. Example: Ollama
#     after `ollama pull qwen2.5:7b`. (With every block commented out, Kratos
#     tries exactly this local Ollama.)
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b
# KRATOS_LLM_BACKEND=openai_compatible

# --- PROFILE: Any other OpenAI-compatible endpoint -- fill in all three values.
# LLM_BASE_URL=http://127.0.0.1:PORT/v1
# LLM_API_KEY=dummy-or-real-key
# LLM_MODEL=your-model-name
# KRATOS_LLM_BACKEND=openai_compatible

# If two blocks are uncommented, the LOWER one wins. Comment the old one out
# before switching (or switch with /model inside Kratos, which does it for you).


# =============================================================================
# 2. OPTIONAL -- everything below works without changes
# =============================================================================

# --- Logging in to the machines you watch ------------------------------------
# Kratos asks which account to log in as when you add a machine (or type it as
# name@host). This is only the fallback for a machine it hasn't asked about:
# KRATOS_SSH_USER=ubuntu
# The SSH key Kratos uses (it can create one for you):
# KRATOS_SSH_KEY_PATH=~/.ssh/id_ed25519

# --- Alerts on your phone (ntfy) ---------------------------------------------
# Off until you set a topic. A topic has no password -- anyone who knows its
# name can read your alerts -- so use a long random name (/doctor suggests one)
# and subscribe to it in the ntfy app. For real use, run your own ntfy server
# and/or set an access token.
# KRATOS_NTFY_TOPIC=<your-own-random-topic>
# KRATOS_NTFY_BASE_URL=https://ntfy.sh
# KRATOS_NTFY_TOKEN=<your-ntfy-access-token>

# --- IP reputation lookups -----------------------------------------------------
# Kratos checks suspicious IPs against a LOCAL copy of AlienVault OTX data; an
# investigation never makes a live call for it. OTX_API_KEY is used only when
# you refresh that copy.
# OTX_API_KEY=your-otx-api-key-here
# A live AbuseIPDB lookup is possible only with BOTH the key and
# KRATOS_THREAT_INTEL_ENABLED=1, and even then Kratos asks you every time.
# ABUSEIPDB_API_KEY=your-abuseipdb-api-key-here
# KRATOS_THREAT_INTEL_ENABLED=0

# --- Model request limits (the defaults suit most models) --------------------
# Seconds to wait for one model answer (local CPU models can be slow):
# KRATOS_LLM_REQUEST_TIMEOUT_SECONDS=900
# Most tokens a long answer may use. Thinking models spend part of this on
# hidden reasoning, so keep it generous:
# KRATOS_LLM_MAX_TOKENS=8192
# Most tokens for a short `kratos chat -q` answer:
# KRATOS_LLM_MAX_TOKENS_QUESTION=512
# Only for loading a GGUF model file in-process (KRATOS_LLM_BACKEND=llama_cpp):
# KRATOS_LLM_MODEL_PATH=/path/to/model.gguf
# KRATOS_LLM_N_CTX=6144
# If the model server is down, don't try loading a GGUF in-process instead
# (on a slow machine that attempt looks like a hang):
KRATOS_LLM_FALLBACK_TO_DIRECT_LOAD=0
